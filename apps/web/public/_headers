# script-src carries no 'unsafe-inline': functions/_middleware.ts puts a nonce per response into this
# header and onto every <script> of an HTML document (functions/lib/csp.ts). Cloudflare adds that nonce
# to the scripts it injects (challenges, email obfuscation) by reading the header. frame-src 'self' stays
# for the same-origin challenge iframe.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://www.clarity.ms https://scripts.clarity.ms https://apis.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.docstoc.io https://chasa.io https://www.chasa.io https://docstoc.io https://www.docstoc.io https://chasa-71s.pages.dev https://challenges.cloudflare.com https://www.clarity.ms https://scripts.clarity.ms https://c.clarity.ms https://b.clarity.ms https://i.clarity.ms https://y.clarity.ms https://r.clarity.ms https://c.bing.com https://content.googleapis.com https://www.googleapis.com; worker-src 'self' blob: https://www.clarity.ms https://scripts.clarity.ms; frame-src 'self' https://challenges.cloudflare.com https://accounts.google.com https://docs.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; report-uri https://api.docstoc.io/api/csp-report

# Embeddable widgets are meant to be iframed on third-party sites for backlink/attribution value.
# Modern browsers use CSP frame-ancestors over the site-wide X-Frame-Options: DENY above when both
# are present (CSP2 spec), so this override is enough to allow framing without weakening any other page.
/tools/embed/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors *; base-uri 'self'; object-src 'none'; report-uri https://api.docstoc.io/api/csp-report

